# PortfolioPro Environment Configuration Example
# Copy this file to .env and configure values before starting the application.
# IMPORTANT: Never commit your actual .env file or real secrets to version control.

# Twelve Data Market Data Provider Configuration
MARKET_DATA_API_KEY=c8ee05da6c33433682d0c8ca90447e1e
MARKET_DATA_BASE_URL=https://api.twelvedata.com

# Timeouts & Cache
MARKET_DATA_CONNECT_TIMEOUT_MS=3000
MARKET_DATA_READ_TIMEOUT_MS=5000
MARKET_DATA_CACHE_TTL_SECONDS=15

# Database Configuration (Optional Overrides)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/portfoliopro?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Security & JWT (Optional Overrides - Generate a 256-bit secret for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
